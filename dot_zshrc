# Powerlevel10k instant prompt.
# Keep near the top, before potentially interactive commands.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Shared plugins.
plugins=(git docker 1password battery)

source "$ZSH/oh-my-zsh.sh"

# Smart directory navigation.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Powerlevel10k configuration.
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# NVM (only on machines where it's installed).
export NVM_DIR="$HOME/.nvm"

if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
    source /opt/homebrew/opt/nvm/nvm.sh
    nvm use default --silent
elif [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
    nvm use default --silent
fi

# Rust toolchain.
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Local tool environment, if installed.
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

# Optional application-specific executables.
for dir in \
    "$HOME/.codeium/windsurf/bin" \
    "$HOME/.opencode/bin" \
    "$HOME/tools/gyp"
do
    [[ -d "$dir" ]] && path=("$dir" $path)
done

# Optional Homebrew Ruby.
[[ -d /opt/homebrew/opt/ruby@3.2/bin ]] &&
    path=(/opt/homebrew/opt/ruby@3.2/bin $path)

# Remove duplicate PATH entries.
typeset -U path

# GitHub issue -> branch -> Claude.
claude-issue() {
    gh issue develop "$1" --checkout &&
    claude "We're working GitHub issue #$1, already on its linked branch. Run \`gh issue view $1 --comments\` for context. Work on THIS branch — do not create a new one — and put 'Closes #$1' in the eventual PR."
}

# Copy command output or a specified amount of tmux scrollback.
cplast() {
    if [[ -z "$TMUX" ]]; then
        print -u2 "cplast: not inside tmux"
        return 1
    fi

    if [[ "$OSTYPE" != darwin* ]]; then
        print -u2 "cplast: clipboard support not configured on this system"
        return 1
    fi

    if (( $# == 0 )); then
        # Copy the previous command's output using semantic shell markers.
        tmux capture-pane -p -F -J -S - | awk '
            {
                separator = index($0, " ")
                if (!separator) next

                flags = substr($0, 1, separator - 1)
                line = substr($0, separator + 1)

                if (flags ~ /P/) {
                    last_output = output
                    output = ""
                    in_command = 0
                    next
                }

                if (flags ~ /O/)
                    in_command = 1

                if (in_command)
                    output = output line "\n"
            }
            END {
                printf "%s", last_output
            }
        ' | pbcopy
    else
        # Copy a specified number of scrollback lines plus the visible pane.
        local lines="$1"

        if [[ ! "$lines" =~ ^[0-9]+$ ]]; then
            print -u2 "cplast: line count must be a nonnegative integer"
            return 1
        fi

        tmux capture-pane -p -J -S "-$lines" | pbcopy
    fi
}
